{
  "manifest_version": 3,
  "name": "DeepSeek Harness 侧栏",
  "version": "0.1.0",
  "description": "在 Chrome 侧栏连接本地 DeepSeek Harness，按项目管理对话与网页引用。",
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "打开 DeepSeek Harness"
  },
  "key": ""
}
